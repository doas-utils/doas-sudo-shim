# ---- Shared shim helpers -----------------------------------------------------------------
# Embedded into doasudo (always) and the edit broker at build time.

_DOASUDO_PATH='@BINDIR@'

_resolve_bin() {
  _rb_path=$(PATH="$_DOASUDO_PATH" command -v "$1" 2>/dev/null) || _rb_path=
  case "$_rb_path" in
    '') [ "${2:-}" = optional ] && return 0; return 1 ;;
    /*) printf '%s' "$_rb_path" ;;
    *) return 1 ;;
  esac
}

# True if path is /dev/... with no ".." segments (broker EDIT_BROKER_TTY; cf. SUDO_TTY).
_is_dev_path() {
  case "$1" in
    *..*) return 1 ;;
    /dev/*) return 0 ;;
    *) return 1 ;;
  esac
}
